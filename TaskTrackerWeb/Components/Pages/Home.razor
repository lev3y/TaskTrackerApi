
@page "/"   // set this page as root
@using TaskTrackerWeb.Models
@inject HttpClient Http  // give the page http which use to send HTTP request to api 
@inject IJSRuntime JS

<h3>Projects</h3>

@if (projects == null)
{
    <p>Loading projects...</p>
}
else
{
    @foreach (var project in projects)
    {
        <div class="card mb-2">
            <div class="card-body">
                <h5 class="mb-3">@project.Name</h5>
                <p class="mb-1">@project.Description</p>
                <p class="mb-1">Tasks: @project.TotalTasks</p>
                <p class="mb-2 text-muted" style="font-size: 0.8rem">Created At: @project.CreatedAt.ToString("dd/MM/yyyy")</p>
                <button class="btn btn-primary" @onclick="() => LoadTasks(project.Id)">
                    View Tasks
                </button>
            </div>
        </div>
    }
}

<br />

@if (tasks != null)
{
    <h3>Tasks
        @if (selectedProjectId != null)
        {
            <span class="fs-6 text-muted">
                (Project: @projects?.FirstOrDefault(p => p.Id == selectedProjectId)?.Name)
            </span>
        }
    </h3>

    <button class="btn btn-success mb-3" @onclick="OpenAddTaskForm">
        Add Task
    </button>
    
    @foreach (var task in tasks)
    {
        <div class="card mb-2">
            <div class="card-body">
                <h5 class="mb-3">@task.Title</h5>
                <p class="mb-1"><span class="fw-bold">Status</span>: @task.Status</p>
                <p class="mb-1"><span class="fw-bold">Description</span>: @(string.IsNullOrWhiteSpace(task.Description) ? "Not Specified" : task.Description)</p>
                <p class="mb-1"><span class="fw-bold">Due Date</span>: @(task.DueDate?.ToString("dd/MM/yyyy") ?? "Not Specified")</p>
                <p class="mb-2 text-muted" style="font-size: 0.8rem">Created At: @task.CreatedAt.ToString("dd/MM/yyyy")</p>
            </div>
            <div class="d-flex gap-2 mx-3 mb-3">
                <button class="btn btn-warning btn-sm flex-fill" @onclick="() => OpenEditTaskForm(task)">
                    Edit
                </button>
                <button class="btn btn-danger btn-sm flex-fill" @onclick="() => DeleteTask(task.Id)">
                    Delete
                </button>
            </div>
        </div>
    }
}

@if (showTaskForm)
{
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingTaskId == null ? "Add Task" : "Edit Task")</h5>
                    <button type="button" class="btn-close"@onclick="CloseTaskForm"></button>
                </div>

                <form @onsubmit="SaveTask" @onsubmit:preventDefault>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input class="form-control" @bind="newTaskTitle" required/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <input class="form-control" @bind="newTaskDescription" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Due Date</label>
                            <input type="date" class="form-control" @bind="newTaskDueDate" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <select class="form-select" @bind="newTaskStatus">
                                <option value="Todo">Todo</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Done">Done</option>
                            </select>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseTaskForm">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-success">
                            @(editingTaskId == null ? "Add Task" : "Save Changes")
                        </button>
                    </div> 
                </form>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<ProjectDto>? projects;

    // built in function that initialize on page load
    protected override async Task OnInitializedAsync() 
    {
        // call API to retrieve the project data, then assign to <ProjectDto> projects
        projects = await Http.GetFromJsonAsync<List<ProjectDto>>(
            "http://localhost:5285/api/projects");
    }

    private async Task ReloadProjects()
    {
        projects = await Http.GetFromJsonAsync<List<ProjectDto>>(
            "http://localhost:5285/api/projects");
    }

    private async Task ReloadTasks(int? projectId)
    {
        if (projectId == null)
        {
            return;
        }
        tasks = await Http.GetFromJsonAsync<List<TaskDto>>(
                $"http://localhost:5285/api/projects/{projectId}/tasks");
    }

    private List<TaskDto>? tasks;
    private int? selectedProjectId;

    private async Task LoadTasks(int projectId)
    {
        selectedProjectId = projectId;

        tasks = await Http.GetFromJsonAsync<List<TaskDto>>(
            $"http://localhost:5285/api/projects/{projectId}/tasks");
    }

    // Task Form
    private int? editingTaskId;
    private string newTaskTitle = string.Empty;
    private string newTaskDescription = string.Empty;
    private string newTaskStatus = "Todo";
    private DateTime? newTaskDueDate;
    private bool showTaskForm = false;
    private void OpenAddTaskForm()
    {
        newTaskTitle = string.Empty;
        newTaskDescription = string.Empty;
        newTaskStatus = "Todo";
        newTaskDueDate = null;
        showTaskForm = true;
    }
    private void CloseTaskForm()
    {
        showTaskForm = false;
        editingTaskId = null;
    }

    private void OpenEditTaskForm(TaskDto task)
    {
        editingTaskId = task.Id;
        newTaskTitle = task.Title;
        newTaskDescription = task.Description ?? string.Empty;
        newTaskStatus = task.Status;
        newTaskDueDate = task.DueDate;
        showTaskForm = true;
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskTitle) || selectedProjectId == null)
        {
            return;
        }

        var response = await Http.PostAsJsonAsync(
            $"http://localhost:5285/api/projects/{selectedProjectId}/tasks",
            new
            {
                Title = newTaskTitle,
                Description = newTaskDescription,
                Status = newTaskStatus,
                DueDate = newTaskDueDate
            }
        );

        if (response.IsSuccessStatusCode)
        {
            await ReloadProjects();
            await ReloadTasks(selectedProjectId);
            CloseTaskForm();
        }
    }

    // Update task
    private async Task UpdateTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskTitle) || editingTaskId == null)
        {
            return;
        }

        var response = await Http.PutAsJsonAsync(
            $"http://localhost:5285/api/tasks/{editingTaskId}",
            new
            {
                Title = newTaskTitle,
                Description = newTaskDescription,
                Status = newTaskStatus,
                DueDate = newTaskDueDate
            }
        );

        if (response.IsSuccessStatusCode)
        {
            await ReloadProjects();
            await ReloadTasks(selectedProjectId);
            CloseTaskForm();
        }
    }

    private async Task SaveTask()
    {
        if (editingTaskId == null)
        {
            await AddTask();
        }
        else
        {
            await UpdateTask();
        }
    }

    // Delete Task
    private async Task DeleteTask(int taskId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this task?");
        if (!confirmed)
        {
            return;
        }

        var response = await Http.DeleteAsync(
            $"http://localhost:5285/api/tasks/{taskId}");

        if (response.IsSuccessStatusCode)
        {
            await ReloadProjects();
            await ReloadTasks(selectedProjectId);
        }
    }
}
